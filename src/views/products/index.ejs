    <%- include('../partials/head', { title: '', css: '/css/indexStyle.css'
    }) %>

    <%- include('../partials/header') %>
    
    <section class="container-main">
        <div class="img-home">
            <img src="/img/home-img.jpg" alt="">
        </div>
        <div class="title">
            <h4 id="men">MEN</h4>
        </div>

        <div class="container-slider">

            <div class="container-carousel">
                <div class="carousels" id="slider">
                    <% locals.productsMen?.forEach(item => { %>
                            <section class="slider-section">
                                <img src="/img/imagenesJSON/<%= item.image %>" alt="">
                            </section>

                    <%    }); %>
                </div>
                <i class="fa-solid fa-arrow-left btn-left"></i>
                <i class="fa-solid fa-arrow-right btn-right"></i>
            </div>
        </div>
     
        
        <div class="container-advice">
            <div class="container-letter">
                <h5>WE MADE YOUR EVERYDAY
                    FASHION BETTER!</h5>
                <p>COMING SOON</p>
                <button>Shop Now</button>
            </div>

        </div>
        <div class="title">
            <h4 id="women">WOMEN</h4>
        </div>

        <div class="container-slider">

            <div class="container-carousel">
                <div class="carousels" id="slider1">
                    <% locals.productsWomen?.forEach(item => { %>
                            <section class="slider-section">
                                <img src="/img/imagenesJSON/<%= item.image %>" alt="">
                            </section>

                        
                    <%    }); %>
                </div>
                <i class="fa-solid fa-arrow-left btn-left  btn-left1"></i>
                <i class="fa-solid fa-arrow-right btn-right  btn-right1"></i>
            </div>
        </div>

        <div class="container-advice background-img">
            <div class="container-letter">
                <h5>VOID X GYMSHARK</h5>
                <p>COMING SOON</p>
                <button>Pre Order</button>
            </div>
        </div>
        </div>

        <div class="title">
            <h4 id="accessories">ACCESORIOS</h4>
        </div>

         <%- include('../partials/carrousel', { btn1: 'btn-left2', btn2: 'btn-right2', id:'slider2'
        }) %>
        
        </div>
    </section>
    <%- include('../partials/footer') %>
    <script src="https://kit.fontawesome.com/6e8142624e.js" crossorigin="anonymous"></script>
    <script src="/javascripts/index.js"></script>
</body>

</html>