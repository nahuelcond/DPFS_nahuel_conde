<%- include('../partials/head', { title: ' Products', css: '/css/productGaleryStyle.css'
}) %>

<%- include('../partials/header') %>

<section class="container-items">
    <% locals.products?.forEach(item => { %>
        <div class="item">
            <figure class="img-product">
                <img src="<%= item.image %>" alt="">
            </figure>
            <div class="info-product">
                <h2><%= item.name %></h2>
                <p class="price-product"><%= item.price %></p>
                <button>Añadir al carrito</button>
            </div>
        </div>
    <%    }); %>

</section>



<%- include('../partials/footer') %>
    <script src="https://kit.fontawesome.com/6e8142624e.js" crossorigin="anonymous"></script>
    <script src="/javascripts/index.js"></script>
</body>

</html>