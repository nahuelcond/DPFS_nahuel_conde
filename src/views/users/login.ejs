    <%- include('../partials/head', { title: ' Login', css: '/css/loginStyle.css'
    }) %>
    <section class="main-container">
        <div class="background-image">
            <img class="background-image" src="/img/login-img2.jpeg" alt="">
        </div>
        <form action="" method="" class="form-login">
            <diV class="log-in-logo">
                <a href=""><img class="logo" alt="" src="/img/logo-1.png" /></a>
            </diV>
            <label for="email-adress">Correo electronico:</label>
            <input id="email-adress" type="email" placeholder="Ingresa tu correo electronico" required />
            <label for="password-login">Contraseña:</label>
            <input id="password-login" type="password" placeholder="Ingresa tu contraseña" required />
            <div class="remember-option">
                <input type="checkbox" name="" id="remember-option">
                <label for="remember-option">Recuerdame</label>
            </div>
            <input class="log-in" type="submit" value="LOG IN">
            <p>¿No tienes cuenta? <a href="">Registrate</a></p>
        </form>
        <div></div>
    </section>
</body>

</html>