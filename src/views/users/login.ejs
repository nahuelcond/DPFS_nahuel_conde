    <%- include('../partials/head', { title: ' Login', css: '/css/loginStyle.css'
    }) %>
    <section class="main-container">
        <div class="background-image">
            <img class="background-image" src="/img/login-img2.jpeg" alt="">
        </div>
        <form action="" method="" class="form-login">
            <diV class="log-in-logo">
                <a href=""><img class="logo" alt="" src="/img/logo-1.png" /></a>
            </diV>
            <label for="first-name">Nombre/s:</label>
            <input type="text" name="" id="first-name" placeholder="Ingresa tu nombre" required>
            <label for="last-name">Apellido/s:</label>
            <input type="text" name="" id="last-name" placeholder="Ingresa tu apellido" required>
            <label for="date-birth">Fecha de nacimiento:</label>
            <input class="date" type="date" name="" id="date-birth" required>
            <label for="email-adress">Correo electronico:</label>
            <input type="text" name="" id="email-adress" placeholder="Ingresa tu correo electronico" required>
            <div class="container-password">
                <label for="password-register">Contraseña:</label>
                <span id="hide-btn">Mostrar</span>
            </div>
            <input type="password" name="" id="password-register" placeholder="Ingresa tu contraseña" required>
            <input class="sign-up" type="submit" value="SIGN UP">
            <p>¿Ya tienes cuenta? <a href="">Login</a></p>
        </form>
        <div></div>
    </section>
    <script src="/javascripts/register.js"></script>

</body>

</html>