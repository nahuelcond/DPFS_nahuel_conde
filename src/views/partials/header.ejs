<header class="container-header" id="container-head">
    <div class="container-hero">

        <div class="container-menu-movil" id="container-menu-bars-icon">
            <i class=" fa-solid fa-bars"></i>
        </div>

        <div class="container-logo">
            <a href=""><img class="logo-home" src="/img/logo-1.png" alt=""></a>
            <ul class="container-nav">
                <li><a href="#men" class="header-selector-1">HOMBRES</a></li>
                <li><a href="#women" class="header-selector-2">MUJERES</a></li>
                <li><a href="#accessories" class="header-selector-3">ACCESORIOS</a></li>
            </ul>
        </div>

        <div class="container-user">
            <div class="container-heart">
                <a href=""><i class="fa-solid fa-heart"></i></a>
            </div>
            <a href=""><i class=" fa-solid fa-user"></i></a>
            <div class="container-shopping-cart">
                <i class="fa-solid fa-cart-shopping " id="shopping-cart"></i>
            </div>
        </div>
    </div>
    <div class="hidden" id="container-menu-bars">
        <div class="container-menu-bars">
            <ul class="menu-bars">
                <div class="menu-bars-links">
                    <i class="fa-solid fa-circle fa-2xs"></i>
                    <li><a href="#men" class="menu-selector-1">HOMBRES</a></li>
                </div>
                <div class="menu-bars-links">
                    <i class="fa-solid fa-circle fa-2xs"></i>
                    <li><a href="#women" class="menu-selector-2">MUJERES</a></li>
                </div>
                <div class="menu-bars-links">
                    <i class="fa-solid fa-circle fa-2xs"></i>
                    <li><a href="#accessories" class="menu-selector-3">ACCESORIOS</a></li>
                </div>
            </ul>
        </div>
    </div>
    <div class="hidden" id="toggle-shopping-cart">
        <div class="shopping-cart-on">
            <h2>TU CARRITO</h2>
            <div class="container-products">
                <div class="shopping-cart-product">
                    <div class="shopping-cart-img">
                        <img src="/img/remera-prueba.jpg" alt="">
                    </div>
                    <div class="container-specs">
                        <h4>REMERA VOID BLANCA</h4>
                        <h5>US$30</h5>
                    </div>
                </div>
                <div class="shopping-cart-product">
                    <div class="shopping-cart-img">
                        <img src="/img/remera-prueba.jpg" alt="">
                    </div>
                    <div class="container-specs">
                        <h4>REMERA VOID BLANCA</h4>
                        <h5>US$30</h5>
                    </div>
                </div>
            </div>
            <form action="" class="form-shopping-cart">

                <div class="shopping-cart-product-process">
                    <div class="container-summary subtotal">
                        <label for="subtotal-num">SUBTOTAL</label>
                        <input type="number" name="subtotal-num" id="" required>
                    </div>
                    <div class="container-summary shipping">
                        <label for="shipping-num">ENVIO</label>
                        <input type="number" name="shipping-num" id="" required>
                    </div>
                    <div class="container-summary total">
                        <label for="total-num">TOTAL</label>
                        <input type="number" name="total-num" id="" required>
                    </div>
                </div>
                <button type="submit">COMPRAR</button>
            </form>
        </div>
    </div>
</header>